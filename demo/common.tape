# Ajustes compartidos por todos los demos (Source desde cada .tape)
Require tmux
Require fzf
Set Shell "bash"
Set FontFamily "MesloLGLDZ Nerd Font Mono"
Set FontSize 15
Set Width 1600
Set Height 820
Set Theme "tokyonight"
Set Padding 14
Set Margin 24
Set MarginFill "#ff9e64"
Set BorderRadius 12
Set WindowBar Colorful
Set TypingSpeed 90ms
